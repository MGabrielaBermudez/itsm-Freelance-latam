# URL base de la API (la capa mock la usa cuando no hay backend real).
VITE_API_BASE_URL=

# Panel de cuentas de demostración en el login.
# true  -> siempre visible
# false -> siempre oculto
# sin definir -> visible solo en desarrollo (import.meta.env.DEV)
VITE_SHOW_DEMO=true

# Probabilidad (0..1) de simular un fallo de red al iniciar sesión. 0 = desactivado.
VITE_AUTH_NETWORK_FAILURE_RATE=0
